# Configurazione del ponte sensore aria Amazon -> Loxone. Sul Raspberry va in /etc/default/amazon-loxone
# (install.sh la crea da questo esempio, solo se non esiste gia').

# Porta della pagina che legge il Miniserver (ingresso virtuale HTTP con indirizzo http://<raspberry>:8095/aria)
HTTP_PORT=8095

# IP da cui accettare richieste, separati da virgola: di solito il Miniserver e 127.0.0.1. Vuoto = tutti.
ALLOW_FROM=

# Ogni quanti secondi chiedere i valori ad Amazon (minimo 60; Home Assistant usa 300)
INTERVAL_S=300

# Nome del sensore nell'app Alexa, o numero di serie, se nell'account ce n'e' piu' di uno (vuoto = il primo)
DEVICE=
