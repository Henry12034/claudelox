# Copia questo file come ".env" e compila i valori. Il file .env resta solo sul tuo PC (escluso da git).

# Indirizzo del Miniserver in rete locale (lo trovi in Loxone Config o nel router)
LOXONE_HOST=192.168.1.10

# Utente DEDICATO creato in Loxone Config per Claude (vedi README, "Installazione").
# Il nome e' sensibile alle maiuscole: "Claude" e "claude" sono utenti diversi.
LOXONE_USER=Claude

# Per leggere e comandare la casa basta il token: lascia vuoto ed esegui UNA volta "lox login" in un
# terminale (la password non viene salvata, resta solo il token in .state/token.json, che dura settimane).
# Serve invece qui per il caricamento DIRETTO del programma ("lox carica --applica"): FTP e token
# amministratore temporaneo. In quel caso resta in chiaro in questo file: usa un utente dedicato.
LOXONE_PASSWORD=

# 4 = token "app" (lunga durata); 2 = token "web" (breve durata)
LOXONE_TOKEN_PERMISSION=4

# OPZIONALE. Utente amministratore alternativo per "lox carica --applica" (upload FTP + riavvio della logica).
# Se LOXONE_USER e' gia' amministratore, lascia vuoto.
LOXONE_ADMIN_USER=
LOXONE_ADMIN_PASSWORD=

# Opzionali
# LOXONE_BACKUPS_DIR=C:\Users\<utente>\Documents\Loxone\Loxone Config\Backups
# LOXONE_CONFIG_EXE=C:\Program Files (x86)\Loxone\LoxoneConfig\LoxoneConfig.exe
# LOXONE_LAN_GATEWAY=192.168.1.1   (per "lox shelly ip"; di default x.x.x.1 della rete del Miniserver)
