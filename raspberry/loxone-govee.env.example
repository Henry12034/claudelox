# Configurazione del ponte Loxone -> Govee. Sul Raspberry va in /etc/default/loxone-govee
# (install.sh la crea da questo esempio, solo se non esiste gia').

# Indirizzo Bluetooth della luce Govee (lo trovi con "loxone_govee.py scan"); piu' luci separate da virgola
GOVEE_ADDRESS=

# Porta UDP su cui il Miniserver manda i comandi (uscita virtuale /dev/udp/<raspberry>/55000)
UDP_PORT=55000

# IP da cui accettare comandi, separati da virgola: di solito solo quello del Miniserver. Vuoto = tutti.
ALLOW_FROM=

# Variante del comando colore per il modello: 02 (classico), 0d, 15 (strisce RGBIC a segmenti)
GOVEE_COLOR_MODE=02

# Luminosita' massima del modello: 255 (modelli classici) oppure 100
GOVEE_BRIGHTNESS_MAX=255

# Scene aggiuntive o corrette per il modello, es. "movie=4,romantic=7,snowflake=15"
GOVEE_SCENES=
